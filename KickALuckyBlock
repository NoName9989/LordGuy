    end,
})

-- Toggle Auto Collect All
local isAutoCollectAll = false

CollectGroup:AddToggle("AutoCollectAllToggle", {
    Text = "Auto Collect All",
    Default = false,
    Callback = function(state)
        isAutoCollectAll = state
    end,
})

-- ==================== AUTO COLLECT LOGIC (ĐÃ SỬA) ====================
task.spawn(function()
    while true do
        wait(1.0)
        
        -- Auto Collect Selected (đã fix)
        if isAutoCollectSelected then
            local selectedTable = Options.CollectDropdown.Value or {}
            for idStr, isSelected in pairs(selectedTable) do
                if isSelected then
                    local id = tonumber(idStr)
                    if id then
                        game:GetService("ReplicatedStorage"):WaitForChild("Shared")
                            :WaitForChild("Packages"):WaitForChild("Network")
                            :WaitForChild("rev_B_Collect"):FireServer(id)
                        wait(0.08)
                    end
                end
            end
        end
        
        -- Auto Collect All (1-30)
        if isAutoCollectAll then
            for i = 1, 30 do
                game:GetService("ReplicatedStorage"):WaitForChild("Shared")
                    :WaitForChild("Packages"):WaitForChild("Network")
                    :WaitForChild("rev_B_Collect"):FireServer(i)
                wait(0.08)
            end
        end
    end
end)

