-- ==================== KICK FARM SETTING ====================
local KickFarmSettingGroup = Tabs.Farm:AddLeftGroupbox("Kick Farm Setting")

local KickRatio = 1
local FarmDelay = 1
local MoveDelay = 5

KickFarmSettingGroup:AddLabel("Kick Ratio (0.1 - 1.0)")

local RatioSlider = KickFarmSettingGroup:AddSlider("RatioSlider", {
    Text = "Kick Ratio",
    Default = 1,
    Min = 0.1,
    Max = 1,
    Rounding = 4,
    Callback = function(v) KickRatio = v end,
})

local RatioInput = KickFarmSettingGroup:AddInput("RatioInput", {
    Default = "1",
    Numeric = true,
    Finished = true,
    Placeholder = "0.1 - 1.0",
    Callback = function(text)
        local num = tonumber(text)
        if num and num >= 0.1 and num <= 1 then
            KickRatio = num
            RatioSlider:SetValue(num)
        else
            KickRatio = 1
            RatioSlider:SetValue(1)
            RatioInput:SetValue("1")
        end
    end,
})

Options.RatioSlider:OnChanged(function()
    local val = Options.RatioSlider.Value
    RatioInput:SetValue(val == 1 and "1" or string.format("%.4f", val))
end)

