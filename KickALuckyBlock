-- ==================== KICK FARM LOGIC ====================
function StartKickFarm()
    local TweenService = game:GetService("TweenService")

    while isKickFarming do
        local player = game.Players.LocalPlayer
        local character = player.Character or player.CharacterAdded:Wait()
        local root = character:WaitForChild("HumanoidRootPart")
        local humanoid = character:WaitForChild("Humanoid")

        -- TP đến vị trí Kick
        root.CFrame = CFrame.new(690.45, 2.99, 231.49)
        wait(1)

        -- Kick
        game:GetService("ReplicatedStorage"):WaitForChild("Shared")
            :WaitForChild("Packages"):WaitForChild("Network")
            :WaitForChild("rev_KickEvent"):FireServer(KickRatio)
        wait(1)

        -- Đợi wave
        local waveFolder = workspace:WaitForChild("Waves")
        local waveDetected = false
        local conn = waveFolder.ChildAdded:Connect(function(child)
            if child:IsA("Model") or child:IsA("Folder") then waveDetected = true end
        end)

        local start = tick()
        repeat
            wait(0.5)
            if tick() - start > 60 then break end
        until waveDetected or not isKickFarming

        conn:Disconnect()
        if not isKickFarming then break end

        wait(4)   -- Đợi 4 giây sau khi wave xong (như bạn yêu cầu)

        local target = Vector3.new(699.77, 3.00, 231.99)

        if FarmMode == "Normal Farm" then
            -- ==================== NORMAL FARM: Tween bay thẳng về đích ====================
            local distance = (target - root.Position).Magnitude
            local currentSpeed = root.Velocity.Magnitude
            if currentSpeed < 40 then currentSpeed = 130 end   -- tốc độ bay tối thiểu

            local tweenTime = distance / currentSpeed

            local tweenInfo = TweenInfo.new(tweenTime, Enum.EasingStyle.Linear)
            local tween = TweenService:Create(root, tweenInfo, {CFrame = CFrame.new(target)})

            tween:Play()
            tween.Completed:Wait()

        else
            -- ==================== TP FARM (giữ nguyên cũ) ====================
            root.CFrame = CFrame.new(674.96, -7.00, 232.41)
            wait(MoveDelay)
            root.CFrame = CFrame.new(target)
        end

        if isKickFarming then wait(FarmDelay) end
    end
    kickTask = nil
end

