-- ==================== SCREEN BLACK & WHITE ====================
local screenGui = nil
local overlayFrame = nil

local function createOverlay(color)
    if overlayFrame then overlayFrame:Destroy() end
    if not screenGui then
        screenGui = Instance.new("ScreenGui")
        screenGui.Name = "FPSOverlay"
        screenGui.ResetOnSpawn = false
        screenGui.IgnoreGuiInset = true
        screenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
    end

    overlayFrame = Instance.new("Frame")
    overlayFrame.Size = UDim2.new(1,0,1,0)
    overlayFrame.BackgroundColor3 = color
    overlayFrame.BorderSizePixel = 0
    overlayFrame.ZIndex = 9999
    overlayFrame.Parent = screenGui
end

FPSGroup:AddToggle("ScreenBlackToggle", {
    Text = "Screen Black",
    Default = false,
    Callback = function(state)
        if state then
            createOverlay(Color3.new(0,0,0))
        else
            if overlayFrame then overlayFrame:Destroy() end
        end
    end,
})

FPSGroup:AddToggle("ScreenWhiteToggle", {
    Text = "Screen White",
    Default = false,
    Callback = function(state)
        if state then
            createOverlay(Color3.new(1,1,1))
        else
            if overlayFrame then overlayFrame:Destroy() end
        end
    end,
})

FPSGroup:AddButton("Reset Screen", function()
    if overlayFrame then overlayFrame:Destroy() end
    if screenGui then screenGui:Destroy() end
    screenGui = nil
    overlayFrame = nil
end)

