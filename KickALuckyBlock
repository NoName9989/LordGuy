-- ==================== FIND MUTATION ====================
local function FindNearbyMutation(root)
    local debris = workspace:FindFirstChild("Debris")
    if not debris then return nil end

    for _, obj in pairs(debris:GetChildren()) do
        if obj:IsA("Model") or obj:IsA("Folder") then
            local part = obj:FindFirstChildWhichIsA("BasePart")

            if part then
                local dist = (part.Position - root.Position).Magnitude

                if dist <= 5 then
                    for _, child in pairs(obj:GetChildren()) do
                        if next(SelectedMutations) == nil or SelectedMutations[child.Name] then
                            return obj, child.Name
                        end
                    end
                end
            end
        end
    end

    return nil
end

-- ==================== MAIN ====================
function StartKickFarm()
    while isKickFarming do
        local player = game.Players.LocalPlayer
        local character = player.Character or player.CharacterAdded:Wait()
        local root = character:WaitForChild("HumanoidRootPart")
        local humanoid = character:WaitForChild("Humanoid")

        -- 1. TP đến điểm kick
        root.CFrame = CFrame.new(690.45, 2.99, 231.49)
        task.wait(1)

        -- 2. Kick (DÙNG BIẾN NGOÀI)
        game:GetService("ReplicatedStorage"):WaitForChild("Shared")
            :WaitForChild("Packages"):WaitForChild("Network")
            :WaitForChild("rev_KickEvent"):FireServer(KickRatio)

        task.wait(1)

        -- 3. Đợi wave
        local waveFolder = workspace:WaitForChild("Waves")
        local waveDetected = false

        local conn = waveFolder.ChildAdded:Connect(function(child)
            if child:IsA("Model") or child:IsA("Folder") then
                waveDetected = true
            end
        end)

        local start = tick()
        repeat
            task.wait(0.5)
        until waveDetected or tick() - start > 60 or not isKickFarming

        conn:Disconnect()
        if not isKickFarming then break end

        -- 4. Check mutation trong 4s
        local foundMutation = nil
local t = tick()

repeat
    -- 🔥 CHỈ scan khi có chọn mutation
    if next(SelectedMutations) ~= nil then
        local _, mut = FindNearbyMutation(root)
        if mut then
            foundMutation = mut
            break
        end
    end

    task.wait(0.2)
until tick() - t >= 4 or not isKickFarming

        if not isKickFarming then break end

        -- 5. Không có → huỷ
        if not foundMutation and next(SelectedMutations) ~= nil then
    -- chỉ huỷ khi có chọn mutation
    root.CFrame = CFrame.new(714.74, 3.00, 232.46)
    task.wait(1)
    continue
end

        -- 6. Có → farm (REAL-TIME MOVE)
        local RunService = game:GetService("RunService")
local target = Vector3.new(699.77, 3.00, 231.99)

local connection
connection = RunService.Heartbeat:Connect(function(dt)
    if not isKickFarming then
        connection:Disconnect()
        return
    end

    local currentPos = root.Position
    local distance = (target - currentPos).Magnitude

    if distance <= 1 then
        root.CFrame = CFrame.new(target)
        connection:Disconnect()
        return
    end

    local speed = humanoid.WalkSpeed + TweenExtraSpeed
    if speed < 20 then speed = 20 end

    -- 🔥 chỉ lấy XZ
    local direction = Vector3.new(
        target.X - currentPos.X,
        0,
        target.Z - currentPos.Z
    ).Unit

    local move = direction * speed * dt
    local newPos = currentPos + move

    -- 🔥 ÉP Y LUÔN BẰNG target.Y
    root.CFrame = CFrame.new(newPos.X, target.Y, newPos.Z)
end)

repeat task.wait() until not connection or not connection.Connected

        -- 7. Delay (DÙNG FarmDelay)
        if isKickFarming then 
            task.wait(FarmDelay)
        end
    end

    kickTask = nil
end

