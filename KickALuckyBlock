-- ==================== AUTO TRADE ====================
function StartAutoTrade()
    task.spawn(function()
        while isAutoTrading do
            task.wait(1)

            if not SelectedPlayerID then continue end

            local player = Players.LocalPlayer
            local target = Players:GetPlayerByUserId(SelectedPlayerID)
            if not target then continue end

            local backpack = player.Backpack
            local humanoid = player.Character and player.Character:FindFirstChild("Humanoid")

            -- nếu không chọn brainrot → lấy tất cả
            local list = SelectedBrainrots
            if next(list) == nil then
                list = {}
                for _, tool in pairs(backpack:GetChildren()) do
                    list[tool.Name] = true
                end
            end

            for brainrotName, _ in pairs(list) do
                local tool = backpack:FindFirstChild(brainrotName)

                if tool then
                    local hasMutation = true

                    if SelectedMutation then
                        local inner = tool:FindFirstChild(brainrotName)
                        if not inner or not inner:FindFirstChild(SelectedMutation) then
                            hasMutation = false
                        end
                    end

                    if hasMutation and humanoid then
                        humanoid:UnequipTools()
                        task.wait(0.1)

                        humanoid:EquipTool(tool)
                        task.wait(0.4)
                    end
                end
            end

            -- 🔥 cooldown chống lỗi khi bị từ chối
            local now = tick()
            if now - lastTradeTime >= TRADE_COOLDOWN then
                lastTradeTime = now

                humanoid:UnequipTools()
                task.wait(0.2)

                ReplicatedStorage:WaitForChild("Shared")
                    :WaitForChild("Packages")
                    :WaitForChild("Network")
                    :WaitForChild("rev_GiftRequest")
                    :FireServer(SelectedPlayerID)
            end

            task.wait(2)
        end
    end)
end

