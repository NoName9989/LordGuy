local _W = game:GetService("Workspace")
local _RS = game:GetService("RunService")
local _P = game:GetService("Players")
local _UI = game:GetService("UserInputService")
local LocalPlayer = _P.LocalPlayer

local Visuals = {
    M_COL = Color3.fromRGB(255, 40, 40),
    S_COL = Color3.fromRGB(0, 160, 255),
    LINE_THICKNESS = 0.25, 
    SHRINK_AMOUNT = 0.15, 
}

-- CẤU HÌNH TẬP TRUNG 100% VÀO THUẬT TOÁN (KHÔNG TỰ ĐỘNG HÓA)
local Prefs = {
    Active = true,
    TotalMines = 100,
    MaxClusterSize = 40, -- Tăng giới hạn cụm của DeepSearch để quét sâu hơn
    UseProbability = true
}

local Memory = {
    Map = { Grid = {}, Marked = {}, ToFlag = {}, ToClear = {} },
    Bounds = { X = 0, Z = 0 },
    Count = -1,
    Pending = false,
    Links = {}
}

local m_abs, m_floor, m_huge, m_round = math.abs, math.floor, math.huge, math.round
local t_sort = table.sort

-- Hàm dọn dẹp bộ nhớ triệt để, xóa toàn bộ nắp chặn cũ khi sang ván mới
local function ClearOldVisuals()
    for x = 0, Memory.Bounds.X - 1 do
        local row = Memory.Map.Grid[x]
        if row then
            for z = 0, Memory.Bounds.Z - 1 do
                local unit = row[z]
                if unit then
                    if unit._dummy then
                        unit._dummy:Destroy()
                        unit._dummy = nil
                    end
                    unit._edges = nil
                    unit.lastMode = "none"
                    unit._gui = nil
                end
            end
        end
    end
end

-- Cơ chế nắp chặn thông minh: Chặn đi bộ ô đỏ - Cho phép nhảy xuyên qua
local function RefreshBox(obj, mode)
    if not obj or not obj.part then return end
    if obj.lastMode == mode then return end
    obj.lastMode = mode

    if not obj._dummy then
        local dummy = Instance.new("Part")
        dummy.Name = "SolverVisual"
        dummy.Size = obj.part.Size - Vector3.new(Visuals.SHRINK_AMOUNT, -0.1, Visuals.SHRINK_AMOUNT)
        dummy.CFrame = obj.part.CFrame + Vector3.new(0, 0.05, 0)
        dummy.Anchored = false 
        dummy.CanCollide = false
        dummy.Transparency = 1
        dummy.Massless = true
        dummy.Parent = obj.part

        local weld = Instance.new("WeldConstraint")
        weld.Part0 = dummy
        weld.Part1 = obj.part
        weld.Parent = dummy
        obj._dummy = dummy

        dummy.Touched:Connect(function(hit)
            if hit and hit.Parent and hit.Parent:IsA("Model") then
                local char = hit.Parent
                if _P:GetPlayerFromCharacter(char) == LocalPlayer then
                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        if obj.lastMode == "mine" then
                            if humanoid.FloorMaterial ~= Enum.Material.Air then
                                dummy.CanCollide = true
                            else
                                dummy.CanCollide = false
                            end
                        else
                            dummy.CanCollide = false
                        end
                    end
                end
            end
        end)

        dummy.TouchEnded:Connect(function(hit)
            if hit and hit.Parent and _P:GetPlayerFromCharacter(hit.Parent) == LocalPlayer then
                task.wait(0.05)
                dummy.CanCollide = false
            end
        end)

        local edges = {}
        obj._edges = edges
        local sx, sy, sz = dummy.Size.X, dummy.Size.Y, dummy.Size.Z
        local r = Visuals.LINE_THICKNESS / 2
        local lenX, lenZ = sx + Visuals.SHRINK_AMOUNT, sz + Visuals.SHRINK_AMOUNT

        local function makeEdge(name, cf, h)
            local cyl = Instance.new("CylinderHandleAdornment")
            cyl.Name = name
            cyl.Adornee = dummy
            cyl.Radius = r
            cyl.Height = h
            cyl.CFrame = cf
            cyl.Transparency = 1
            cyl.ZIndex = 5
            cyl.AlwaysOnTop = true
            cyl.Parent = dummy
            edges[name] = cyl
        end

        makeEdge("TR", CFrame.new(sx/2, sy/2, 0), lenZ)
        makeEdge("TL", CFrame.new(-sx/2, sy/2, 0), lenZ)
        makeEdge("TF", CFrame.new(0, sy/2, sz/2) * CFrame.Angles(0, math.pi/2, 0), lenX)
        makeEdge("TB", CFrame.new(0, sy/2, -sz/2) * CFrame.Angles(0, math.pi/2, 0), lenX)
    end
end

local function RefreshOutline(unit)
    if not unit._edges then return end
    if unit.lastMode == "none" or not unit.hidden then
        for _, edge in pairs(unit._edges) do edge.Transparency = 1 end
        return
    end

    local c = unit.lastMode
    local col = (c == "mine" and Visuals.M_COL) or Visuals.S_COL
    local function isSameGroup(nx, nz)
        local n = Memory.Map.Grid[nx] and Memory.Map.Grid[nx][nz]
        return n and n.lastMode == c and n.hidden
    end

    local x, z = unit.ix, unit.iz
    local function setE(name, show)
        local e = unit._edges[name]
        if e then
            if show then e.Color3 = col e.Transparency = 0 else e.Transparency = 1 end
        end
    end

    setE("TR", not isSameGroup(x+1, z))
    setE("TL", not isSameGroup(x-1, z))
    setE("TF", not isSameGroup(x, z+1))
    setE("TB", not isSameGroup(x, z-1))
end

local function BindFolder(target)
    for _, v in ipairs(Memory.Links) do v:Disconnect() end
    Memory.Links = {}
    table.insert(Memory.Links, target.ChildAdded:Connect(function() Memory.Pending = true end))
    table.insert(Memory.Links, target.ChildRemoved:Connect(function() Memory.Pending = true end))
end

local function GroupCoordinates(set)
    if #set == 0 then return {} end
    local res = {}
    local lastV = m_round(set[1] * 10) / 10
    table.insert(res, lastV)
    for i = 2, #set do
        local curV = m_round(set[i] * 10) / 10
        if m_abs(curV - lastV) > 1.5 then table.insert(res, curV) lastV = curV end
    end
    return res
end

local function MapOutEnvironment(src)
    ClearOldVisuals()
    Memory.Map.Grid = {}
    local items = src:GetChildren()
    if #items == 0 then return end

    local raw, xCoords, zCoords = {}, {}, {}
    for _, p in ipairs(items) do
        if p:IsA("BasePart") and p.Transparency < 0.5 then
            table.insert(raw, {obj = p, loc = p.Position})
            table.insert(xCoords, p.Position.X)
            table.insert(zCoords, p.Position.Z)
        end
    end
    if #xCoords == 0 then return end
    t_sort(xCoords) t_sort(zCoords)

    local uX, uZ = GroupCoordinates(xCoords), GroupCoordinates(zCoords)
    Memory.Bounds.X, Memory.Bounds.Z = #uX, #uZ

    for x = 0, Memory.Bounds.X - 1 do
        Memory.Map.Grid[x] = {}
        for z = 0, Memory.Bounds.Z - 1 do
            Memory.Map.Grid[x][z] = {
                ix = x, iz = z, adj = {}, status = "unknown", hidden = true,
                _edges = nil, _dummy = nil, lastMode = "none", val = 0
            }
        end
    end

    for _, d in ipairs(raw) do
        local rX, rZ = 1, 1
        local dX, dZ = m_huge, m_huge
        for i, v in ipairs(uX) do if m_abs(d.loc.X - v) < dX then dX = m_abs(d.loc.X - v) rX = i end end
        for i, v in ipairs(uZ) do if m_abs(d.loc.Z - v) < dZ then dZ = m_abs(d.loc.Z - v) rZ = i end end
        local gridX = Memory.Map.Grid[rX-1]
        local unit = gridX and gridX[rZ-1]
        if unit then unit.part = d.obj unit.pos = d.loc end
    end

    for x = 0, Memory.Bounds.X - 1 do
        for z = 0, Memory.Bounds.Z - 1 do
            local unit = Memory.Map.Grid[x][z]
            if unit then
                for ox = -1, 1 do
                    for oz = -1, 1 do
                        if not (ox == 0 and oz == 0) then
                            local nx, nz = x + ox, z + oz
                            if Memory.Map.Grid[nx] and Memory.Map.Grid[nx][nz] then
                                table.insert(unit.adj, Memory.Map.Grid[nx][nz])
                            end
                        end
                    end
                end
            end
        end
    end
    BindFolder(src)
end

local function ScanGrid()
    Memory.Map.Marked = {}
    for x = 0, Memory.Bounds.X - 1 do
        for z = 0, Memory.Bounds.Z - 1 do
            local unit = Memory.Map.Grid[x][z]
            local p = unit.part
            if p then
                unit._gui = unit._gui or p:FindFirstChild("NumberGui") or p:FindFirstChild("numbergui")
                local ui = unit._gui
                if ui then
                    unit.hidden = false
                    unit.status = "number"
                    local lb = ui:FindFirstChildWhichIsA("TextLabel")
                    unit.val = lb and tonumber(lb.Text) or 0
                    table.insert(Memory.Map.Marked, unit)
                elseif p:FindFirstChild("Flag") or p:FindFirstChild("flag") then
                    unit.status = "flagged"
                    unit.hidden = false
                else
                    unit.status = "unknown"
                    unit.hidden = true
                end
            end
        end
    end
end

local function SetLogicSearch(foundMines, toOpen)
    local activeNodes = {}
    for _, unit in ipairs(Memory.Map.Marked) do
        local mystery, fCount = {}, 0
        for _, n in ipairs(unit.adj) do
            if foundMines[n] or n.status == "flagged" then fCount += 1
            elseif n.hidden and not toOpen[n] then table.insert(mystery, n) end
        end
        local gap = unit.val - fCount
        if #mystery > 0 then table.insert(activeNodes, {gap = gap, unk = mystery}) end
    end

    for i = 1, #activeNodes do
        for j = 1, #activeNodes do
            if i ~= j then
                local setA, setB = activeNodes[i], activeNodes[j]
                local intersect, aOnly, bMap = {}, {}, {}
                for _, u in ipairs(setB.unk) do bMap[u] = true end
                for _, u in ipairs(setA.unk) do
                    if bMap[u] then table.insert(intersect, u) else table.insert(aOnly, u) end
                end
                if #intersect > 0 then
                    local bOnly, iMap = {}, {}
                    local changed = false
                    for _, u in ipairs(intersect) do iMap[u] = true end
                    for _, u in ipairs(setB.unk) do if not iMap[u] then table.insert(bOnly, u) end end
                    
                    local maxInI = setA.gap > #intersect and #intersect or setA.gap
                    if setB.gap - maxInI == #bOnly and #bOnly > 0 then
                        for _, u in ipairs(bOnly) do if not foundMines[u] then foundMines[u] = true changed = true end end
                    end
                    local minInI = (setA.gap - #aOnly) < 0 and 0 or (setA.gap - #aOnly)
                    if setB.gap == minInI and #bOnly > 0 then
                        for _, u in ipairs(bOnly) do if not toOpen[u] then toOpen[u] = true foundMines[u] = false changed = true end end
                    end
                    if changed then return true end
                end
            end
        end
    end
    return false
end

local function DeepSearch(foundMines, toOpen)
    local edge, active, edgeReg = {}, {}, {}
    for _, unit in ipairs(Memory.Map.Marked) do
        local mystery, fCount = {}, 0
        for _, n in ipairs(unit.adj) do
            if foundMines[n] or n.status == "flagged" then fCount += 1
            elseif n.hidden and not toOpen[n] then table.insert(mystery, n) end
        end
        local gap = unit.val - fCount
        if #mystery > 0 then
            table.insert(active, {gap = gap, unk = mystery})
            for _, u in ipairs(mystery) do if not edgeReg[u] then edgeReg[u] = true table.insert(edge, u) end end
        end
    end

    if #edge == 0 then return false end
    local link = {}
    for _, u in ipairs(edge) do link[u] = {} end
    for _, a in ipairs(active) do
        for i = 1, #a.unk do
            for j = i + 1, #a.unk do
                link[a.unk[i]][a.unk[j]] = true
                link[a.unk[j]][a.unk[i]] = true
            end
        end
    end

    local seen, clusters = {}, {}
    for _, u in ipairs(edge) do
        if not seen[u] then
            local group = {}
            local stack = {u}
            seen[u] = true
            local ptr = 1
            while ptr <= #stack do
                local cur = stack[ptr] ptr += 1
                table.insert(group, cur)
                for side in pairs(link[cur]) do
                    if not seen[side] then seen[side] = true table.insert(stack, side) end
                end
            end
            table.insert(clusters, group)
        end
    end

    local success = false
    for _, bundle in ipairs(clusters) do
        if #bundle <= Prefs.MaxClusterSize then 
            local bundleNums = {}
            local bSet = {}
            for _, c in ipairs(bundle) do bSet[c] = true end
            for _, a in ipairs(active) do
                for _, u in ipairs(a.unk) do if bSet[u] then table.insert(bundleNums, a) break end end
            end

            local winCount = 0
            local totalMines = {}
            for _, c in ipairs(bundle) do totalMines[c] = 0 end

            local function Recursive(step)
                if step > #bundle then
                    winCount += 1
                    for _, c in ipairs(bundle) do if foundMines[c] == true then totalMines[c] += 1 end end
                    return
                end
                local target = bundle[step]
                
                foundMines[target] = false
                local okS = true
                for _, a in ipairs(bundleNums) do
                    local pot, cur = 0, 0
                    for _, u in ipairs(a.unk) do
                        if foundMines[u] == true then cur += 1
                        elseif foundMines[u] == nil then pot += 1 end
                    end
                    if cur + pot < a.gap then okS = false break end
                end
                if okS then Recursive(step + 1) end

                foundMines[target] = true
                local okM = true
                for _, a in ipairs(bundleNums) do
                    local cur = 0
                    for _, u in ipairs(a.unk) do if foundMines[u] == true then cur += 1 end end
                    if cur > a.gap then okM = false break end
                end
                if okM then Recursive(step + 1) end
                foundMines[target] = nil 
            end

            Recursive(1)
            if winCount > 0 then
                for _, c in ipairs(bundle) do
                    if totalMines[c] == winCount then foundMines[c] = true success = true
                    elseif totalMines[c] == 0 then toOpen[c] = true foundMines[c] = false success = true
                    else foundMines[c] = nil end
                end
            end
        end
    end
    return success
end

-- THUẬT TOÁN TOÁN HỌC MA TRẬN SIÊU XÁC XUẤT V4 (ĐỘ CHÍNH XÁC TUYỆT ĐỐI)
-- Tách biệt hoàn toàn các biên độc lập + Ưu tiên Heuristic giải điểm nóng trước
local function ProbabilityFallback(foundMines, toOpen)
    local frontier = {}
    local frontierMap = {}

    for _, unit in ipairs(Memory.Map.Marked) do
        for _, n in ipairs(unit.adj) do
            if n.hidden and not foundMines[n] and not frontierMap[n] then
                frontierMap[n] = true
                table.insert(frontier, n)
            end
        end
    end

    if #frontier == 0 then return false end

    local cellConstraints = {}
    local cellToConstraints = {}
    local constraintScores = {}
    for _, cell in ipairs(frontier) do cellToConstraints[cell] = {} constraintScores[cell] = 0 end

    for _, unit in ipairs(Memory.Map.Marked) do
        local cells = {}
        local flagged = 0
        for _, n in ipairs(unit.adj) do
            if foundMines[n] or n.status == "flagged" then flagged += 1
            elseif frontierMap[n] then table.insert(cells, n) end
        end
        local need = unit.val - flagged
        if #cells > 0 then
            local constr = { cells = cells, need = need }
            table.insert(cellConstraints, constr)
            for _, cell in ipairs(cells) do
                table.insert(cellToConstraints[cell], constr)
                constraintScores[cell] = constraintScores[cell] + 1 
            end
        end
    end

    -- CHIA CỤM ĐỒ THỊ BIÊN ĐỘC LẬP (Connected Components Splitter)
    local visited = {}
    local chunks = {}
    for _, startCell in ipairs(frontier) do
        if not visited[startCell] then
            local chunkCells = {}
            local queue = { startCell }
            visited[startCell] = true
            local head = 1
            while head <= #queue do
                local cell = queue[head] head += 1
                table.insert(chunkCells, cell)
                for _, constr in ipairs(cellToConstraints[cell]) do
                    for _, neighborCell in ipairs(constr.cells) do
                        if not visited[neighborCell] then
                            visited[neighborCell] = true
                            table.insert(queue, neighborCell)
                        end
                    end
                end
            end
            table.insert(chunks, chunkCells)
        end
    end

    local globalChanged = false
    local absoluteSafest = nil
    local absoluteMinRisk = 1.1

    for _, chunk in ipairs(chunks) do
        -- Heuristic Sorting: Sắp xếp các ô có mật độ số chạm vào nhiều nhất lên đầu
        -- Giúp cắt tỉa nhánh đệ quy sai cực nhanh, đẩy giới hạn tính toán an toàn lên 25 ô
        t_sort(chunk, function(a, b) return constraintScores[a] > constraintScores[b] end)
        if #chunk > 25 then
            local tempChunk = {}
            for i = 1, 25 do table.insert(tempChunk, chunk[i]) end
            chunk = tempChunk
        end

        local chunkMap = {}
        for _, c in ipairs(chunk) do chunkMap[c] = true end

        local subConstraints = {}
        for _, constr in ipairs(cellConstraints) do
            local match = false
            for _, c in ipairs(constr.cells) do if chunkMap[c] then match = true break end end
            if match then table.insert(subConstraints, constr) end
        end

        local mineFreq = {}
        local solutions = 0
        for _, c in ipairs(chunk) do mineFreq[c] = 0 end
        local assign = {}

        local function ValidPartial()
            for _, c in ipairs(subConstraints) do
                local mines = 0
                local unknown = 0
                for _, cell in ipairs(c.cells) do
                    local v = assign[cell]
                    if v == true then mines += 1
                    elseif v == nil then unknown += 1 end
                end
                if mines > c.need or (mines + unknown) < c.need then return false end
            end
            return true
        end

        local function DFS(idx)
            if idx > #chunk then
                solutions += 1
                for _, cell in ipairs(chunk) do if assign[cell] then mineFreq[cell] += 1 end end
                return
            end
            local cell = chunk[idx]

            assign[cell] = false
            if ValidPartial() then DFS(idx + 1) end

            assign[cell] = true
            if ValidPartial() then DFS(idx + 1) end

            assign[cell] = nil
        end

        DFS(1)

        -- Phân tích ma trận kết quả từ toàn bộ tổ hợp nghiệm hợp lệ
        if solutions > 0 then
            for _, cell in ipairs(chunk) do
                local risk = mineFreq[cell] / solutions
                if risk == 1 then
                    foundMines[cell] = true -- Ô chắc chắn có mìn 100%
                    globalChanged = true
                elseif risk == 0 then
                    toOpen[cell] = true -- Ô chắc chắn an toàn 0% mìn
                    foundMines[cell] = false
                    globalChanged = true
                elseif risk < absoluteMinRisk then
                    absoluteMinRisk = risk
                    absoluteSafest = cell
                end
            end
        end
    end

    if globalChanged or next(toOpen) then return true end
    
    -- Nếu không có ô an toàn tuyệt đối, tìm ô có tỉ lệ rủi ro thấp nhất hệ thống
    if absoluteSafest then toOpen[absoluteSafest] = true foundMines[absoluteSafest] = false return true end
    return false
end

local function Compute()
    local foundMines = {}
    local toOpen = {} 
    
    for x = 0, Memory.Bounds.X - 1 do
        for z = 0, Memory.Bounds.Z - 1 do
            local unit = Memory.Map.Grid[x][z]
            if unit then
                if not unit.hidden then toOpen[unit] = nil 
                elseif unit.status == "flagged" or (Memory.Map.ToFlag and Memory.Map.ToFlag[unit]) then 
                    foundMines[unit] = true 
                end
            end
        end
    end

    local act = true
    while act do
        act = false
        if Prefs.TotalMines and Prefs.TotalMines > 0 then
            local fCount, unks = 0, {}
            for x = 0, Memory.Bounds.X - 1 do
                for z = 0, Memory.Bounds.Z - 1 do
                    local u = Memory.Map.Grid[x][z]
                    if u then
                        if foundMines[u] or u.status == "flagged" then fCount += 1
                        elseif u.hidden and not toOpen[u] then table.insert(unks, u) end
                    end
                end
            end
            local rem = Prefs.TotalMines - fCount
            if rem == #unks and #unks > 0 then 
                for _, u in ipairs(unks) do foundMines[u] = true act = true end
            elseif rem == 0 and #unks > 0 then 
                for _, u in ipairs(unks) do toOpen[u] = true act = true end 
            end
        end

        for _, unit in ipairs(Memory.Map.Marked) do
            local mystery, fCount = {}, 0
            for _, n in ipairs(unit.adj) do
                if foundMines[n] or n.status == "flagged" then fCount += 1
                elseif n.hidden and not toOpen[n] then table.insert(mystery, n) end
            end
            local left = unit.val - fCount
            if left == #mystery and left > 0 then
                for _, u in ipairs(mystery) do if not foundMines[u] then foundMines[u] = true act = true end end
            elseif left == 0 and #mystery > 0 then
                for _, u in ipairs(mystery) do if not toOpen[u] then toOpen[u] = true act = true end end
            end
        end

        if not act then act = SetLogicSearch(foundMines, toOpen) end
        if not act then act = DeepSearch(foundMines, toOpen) end
        if not act and Prefs.UseProbability then act = ProbabilityFallback(foundMines, toOpen) end
    end

    local resultFlags = {}
    for unit, val in pairs(foundMines) do if val == true then resultFlags[unit] = true end end
    Memory.Map.ToFlag = resultFlags
    Memory.Map.ToClear = toOpen
end

