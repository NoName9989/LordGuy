-- Toggle 1: Auto Farm All Chest
local AutoFarmAllToggle = FarmLeft:AddToggle("AutoFarmAll", {
    Text = "Auto Farm Chest",
    Default = false,
    Tooltip = "Auto TP and Open Chest",
})

local farmAllConnection = nil
local isFarmingAll = false

AutoFarmAllToggle:OnChanged(function(state)
    isFarmingAll = state

    if state then
        Library:Notify({ Title = "HG Gui", Description = "Auto Farm Chest đã BẬT", Time = 3 })
        
        farmAllConnection = task.spawn(function()
            while isFarmingAll and not Library.Unloaded do
                local chestsFolder = workspace:WaitForChild("Chests", 3)
                if not chestsFolder then 
                    task.wait(1) 
                    continue 
                end

                local openedAny = false

                for _, chest in ipairs(chestsFolder:GetChildren()) do
                    if not isFarmingAll then break end

                    local prompt = chest:FindFirstChild("ProximityPrompt", true)
                    if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Enabled then
                        continue
                    end

                    local character = game.Players.LocalPlayer.Character
                    if not character or not character:FindFirstChild("HumanoidRootPart") then continue end

                    -- TP đến rương
                    local targetPart = prompt.Parent
                    if not targetPart:IsA("BasePart") then
                        targetPart = chest:FindFirstChildWhichIsA("BasePart")
                    end

                    if targetPart then
                        character:PivotTo(targetPart.CFrame * CFrame.new(0, 5, 3))
                        task.wait(0.7)
                    end

                    fireproximityprompt(prompt)
                    print("HG Gui → Đã mở: " .. chest.Name)
                    openedAny = true

                    task.wait(1.3) -- Delay an toàn
                end

                if not openedAny then
                    Library:Notify({ Title = "HG Gui", Description = "Đã mở hết rương hoặc không còn rương mới!", Time = 4 })
                    task.wait(4)
                end

                task.wait(0.8)
            end
        end)
    else
        Library:Notify({ Title = "HG Gui", Description = "Auto Farm All đã TẮT", Time = 3 })
        if farmAllConnection then
            task.cancel(farmAllConnection)
            farmAllConnection = nil
        end
    end
end)

