-- Hàm bật Noclip trong 5 giây
local function EnableNoclipFor5Seconds()
    local character = player.Character
    if not character then return end

    local noclipConn = game:GetService("RunService").Stepped:Connect(function()
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end)

    task.delay(5, function()
        if noclipConn then noclipConn:Disconnect() end
        if character then
            for _, part in pairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end)
end

-- Hàm Teleport an toàn (Y = 200)
local function SafeTeleport(targetCFrame, locationName)
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        Library:Notify({Title = "HG Gui", Description = "Chưa load nhân vật!", Time = 3})
        return
    end

    local root = character.HumanoidRootPart
    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

    -- Độ cao +200 như yêu cầu
    local safeCFrame = targetCFrame * CFrame.new(0, 200, 8)

    character:PivotTo(safeCFrame)

    -- Bật Noclip 5 giây
    EnableNoclipFor5Seconds()

    Library:Notify({Title = "HG Gui", Description = "✅ TP đến " .. locationName .. " (+200 Y + Noclip 5s)", Time = 3})
end

