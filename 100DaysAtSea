-- Tạo GUI 1 nút
local oneButtonScreenGui = nil
local oneButtonFrame = nil

local function CreateOneButtonGUI()
    if oneButtonScreenGui then return end

    local player = game.Players.LocalPlayer

    oneButtonScreenGui = Instance.new("ScreenGui")
    oneButtonScreenGui.Name = "HG_OneButton"
    oneButtonScreenGui.ResetOnSpawn = false
    oneButtonScreenGui.Parent = player:WaitForChild("PlayerGui")

    oneButtonFrame = Instance.new("Frame")
    oneButtonFrame.Size = UDim2.new(0, 290, 0, 140)
    oneButtonFrame.Position = UDim2.new(0, 25, 0.3, 0)
    oneButtonFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    oneButtonFrame.BorderSizePixel = 0
    oneButtonFrame.Parent = oneButtonScreenGui

    -- Title
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 40)
    title.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    title.Text = "HG Gui - 1 Nút Auto Chest"
    title.TextColor3 = Color3.new(1, 1, 1)
    title.TextScaled = true
    title.Font = Enum.Font.GothamBold
    title.Parent = oneButtonFrame

    -- Button
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0.92, 0, 0, 65)
    button.Position = UDim2.new(0.04, 0, 0, 48)
    button.BackgroundColor3 = Color3.fromRGB(0, 162, 255)
    button.Text = "TP & Mở Rương Tiếp Theo"
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextScaled = true
    button.Font = Enum.Font.GothamSemibold
    button.Parent = oneButtonFrame

    -- Status
    local statusLabel = Instance.new("TextLabel")
    statusLabel.Size = UDim2.new(1, 0, 0, 25)
    statusLabel.Position = UDim2.new(0, 0, 1, -28)
    statusLabel.BackgroundTransparency = 1
    statusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
    statusLabel.TextScaled = true
    statusLabel.Text = "Rương 1 / ?"
    statusLabel.Parent = oneButtonFrame

    -- Logic
    local currentIndex = 1
    local chestsFolder = workspace:WaitForChild("Chests")

    local function TeleportAndOpenNextChest()
        local allChests = chestsFolder:GetChildren()
        if #allChests == 0 then
            button.Text = "Không tìm thấy rương!"
            return
        end

        if currentIndex > #allChests then
            button.Text = "Đã mở hết rương!"
            button.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
            statusLabel.Text = "Hoàn thành tất cả"
            return
        end

        local chest = allChests[currentIndex]
        local prompt = chest:FindFirstChild("ProximityPrompt", true)

        if not prompt or not prompt.Enabled then
            currentIndex += 1
            statusLabel.Text = "Rương " .. currentIndex .. " / " .. #allChests
            TeleportAndOpenNextChest()
            return
        end

        local character = player.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            local targetPart = prompt.Parent
            if not targetPart:IsA("BasePart") then
                targetPart = chest:FindFirstChildWhichIsA("BasePart")
            end
            if targetPart then
                character:PivotTo(targetPart.CFrame * CFrame.new(0, 5, 3))
                task.wait(0.7)
            end
        end

        fireproximityprompt(prompt)
        print("HG Gui → Mở rương " .. currentIndex .. ": " .. chest.Name)

        currentIndex += 1
        statusLabel.Text = "Rương " .. currentIndex .. " / " .. #allChests

        if currentIndex <= #allChests then
            button.Text = "TP & Mở Rương " .. currentIndex
        else
            button.Text = "Đã mở hết rương!"
            button.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
        end
    end

    button.MouseButton1Click:Connect(TeleportAndOpenNextChest)

    -- Update số lượng ban đầu
    task.spawn(function()
        statusLabel.Text = "Rương 1 / " .. #chestsFolder:GetChildren()
    end)
end

