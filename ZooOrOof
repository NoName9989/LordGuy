-- ESP ANIMAL
newToggle(misc,"ESP Animal","ESP")

local ESP={}
local TR={}

RunService.RenderStepped:Connect(function()

local folder=workspace.Gameplay.Dynamic.Animals
local char=LocalPlayer.Character
if not char then return end
local root=char:FindFirstChild("HumanoidRootPart")
if not root then return end

-- remove deleted
for part,_ in pairs(ESP) do
if not part or not part.Parent then
ESP[part]:Destroy()
TR[part]:Remove()
ESP[part]=nil
TR[part]=nil
end
end

if not Toggles.ESP then
for _,v in pairs(ESP) do v.Enabled=false end
for _,v in pairs(TR) do v.Visible=false end
return
end

for _,model in pairs(folder:GetChildren()) do
local base = model:IsA("BasePart") and model or model:FindFirstChildWhichIsA("BasePart")

if base then

if not ESP[base] then
local h=Instance.new("Highlight")
h.FillColor=Color3.fromRGB(255,0,0)
h.OutlineColor=Color3.new(1,1,1)
h.FillTransparency=0.5
h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
h.Adornee=base
h.Parent=game.CoreGui
ESP[base]=h
end

if not TR[base] then
local l=Drawing.new("Line")
l.Thickness=2
l.Color=Color3.new(1,1,1)
l.Transparency=1
TR[base]=l
end

local pos,vis=Camera:WorldToViewportPoint(base.Position)
local my=Camera:WorldToViewportPoint(root.Position)

if vis then
TR[base].From=Vector2.new(my.X,my.Y)
TR[base].To=Vector2.new(pos.X,pos.Y)
TR[base].Visible=true
else
TR[base].Visible=false
end

ESP[base].Enabled=true

end
end

end)
