status.TextSize = 13
status.TextColor3 = Color3.fromRGB(200,200,200)

get.MouseButton1Click:Connect(function()
    local link = GetKeyLink .. "?hwid=" .. HWID
    setclipboard(link)
    status.Text = "Copied get key link"
end)

local function close()
    TweenService:Create(bg,TweenInfo.new(.3),{
        BackgroundTransparency = 1
    }):Play()

    TweenService:Create(holder,TweenInfo.new(.3),{
        Position = holder.Position + UDim2.new(0,0,0,40),
        BackgroundTransparency = 1
    }):Play()

    task.wait(.3)
    gui:Destroy()
end

check.MouseButton1Click:Connect(function()
    status.Text = "Checking key..."
    
    local url = CheckAPI .. "?key=" .. box.Text .. "&hwid=" .. HWID
    
    local ok,res = pcall(function()
        return game:HttpGet(url)
    end)

    if ok and (res == "OK" or res == "valid" or res == "true") then
        status.Text = "Key valid"
        task.wait(.5)
        loadstring(game:HttpGet(ScriptLink))()
        close()
    else
        status.Text = "Invalid key"
    end
end)
